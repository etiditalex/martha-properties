# Optional: live Google reviews (Places API — New)
# https://developers.google.com/maps/documentation/places/web-service/get-place
#
# 1. Enable "Places API (New)" in Google Cloud Console
# 2. Create an API key (restrict it to Places API + your domains)
# 3. Find your Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
#
GOOGLE_PLACES_API_KEY=
# Example: ChIJxxxxxxxxxxxxxxxx
GOOGLE_PLACE_ID=

# Public link to your Google Maps listing (reviews tab). Shown as "View on Google Maps".
# Example: https://www.google.com/maps/search/?api=1&query_place_id=ChIJxxxxxxxxxxxxxxxx
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
